{
  "manifest_version": 3,
  "name": "Finite for YouTube",
  "version": "1.1.0",
  "description": "Limits your YouTube home feed to a small daily list, with no infinite scroll. Everything stays on your device.",
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "finite-for-youtube@lukejimenez",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "distractions.css",
        "search.css",
        "subscriptions.css",
        "watch.css",
        "searchbar.css",
        "responsive.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Finite settings",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  }
}
